// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  GUEST
}

model User {
  id String @id @default(cuid())
  username String @unique
  passwordHash String @map("password_hash")
  gmail String? @map("gmail")
  role Role @default(GUEST)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt DateTime @default(now()) @map("created_at")

  pathMaps PathMap[]
  activeSession ActiveSession[]
  starPaths StarPath[]
  trashShedule TrashShedule[]
  shareLink ShareLink[]
  recentItems RecentItem[]
  apiKeys ApiKey[]
  drops Drop[]
  inboxes Inbox[]

  @@map("users")
}

model ActiveSession {
  id String @id @default(cuid())          // also the JWT "jti" claim
  token String                            // sha256 of the issued JWT
  userAgent String
  created_at DateTime @default(now()) @map("created_at")
  expiresAt DateTime @default(now()) @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  @@index([userId], name: "dix_active_session_user_id")
  @@map("active_session")
}

model PathMap {
  id String @id @default(cuid())
  rootPath String @map("root_path")
  description String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  @@index([userId], name: "idx_path_maps_user_id")
  @@map("path_maps")
}

model StarPath {
  id String @id @default(cuid())
  rootPath String @map("root_path")

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String @map("user_id")

  @@index([userId], name: "idx_star_path_user_id")
  @@unique([userId, rootPath], name: "idx_user_path_unique")
  @@map("star_paths")
}

model TrashShedule {
  id          String       @id @default(cuid())
  item        String       @map("item")
  returnPath  String       @map("return_path")              // physical path at delete time (legacy)
  originalPath String?     @map("original_path")            // virtual path to restore to

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String       @map("user_id")

  addDate    DateTime      @default(now())
  expireDate DateTime

  @@index([userId], name: "idx_trash_schedule_user_id")
  @@unique([userId, item], name: "idx_user_item_unique")
  @@map("trash_schedule")
}

model ShareLink {
  id          String        @id @default(cuid())
  rootPath    String        @map("root_path")

  view        Int           @default(0)

  recursive   Boolean       @default(false)       // for folder share

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String        @map("user_id")

  createAt    DateTime      @default(now())
  expireAt    DateTime?
  @@index([userId], name: "idx_share_link_user_id")
  @@map("share_link")
}

// Admin-managed folder protection: blocks the listed actions on a path for one role
model PathRule {
  id          String        @id @default(cuid())
  path        String        @map("path")                // virtual path under STORAGE_ROOT
  role        Role
  actions     String        @map("actions")             // comma-separated FileAction list (blocked actions)
  recursive   Boolean       @default(true)              // also applies to everything inside the folder
  note        String?
  isDefault   Boolean       @default(false) @map("is_default")

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([path, role], name: "idx_path_role_unique")
  @@map("path_rules")
}

model AppSetting {
  key         String        @id
  value       String

  @@map("app_settings")
}

// Files and folders a user recently opened, downloaded or changed (Recent view)
model RecentItem {
  id          String        @id @default(cuid())
  path        String        @map("path")                // virtual path under STORAGE_ROOT
  action      String        @map("action")
  usedAt      DateTime      @default(now()) @map("used_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String        @map("user_id")

  @@unique([userId, path], name: "idx_recent_user_path")
  @@index([userId, usedAt], name: "idx_recent_user_used_at")
  @@map("recent_items")
}

// Key for calling /api/v1 from another program. Only the sha256 of the key is stored.
model ApiKey {
  id             String    @id @default(cuid())
  name           String
  prefix         String    @unique                        // public part of the key, used to look it up and shown in the UI
  keyHash        String    @unique @map("key_hash")       // sha256 of the full key
  scopes         String                                    // comma-separated ApiScope list
  rootPath       String?   @map("root_path")              // virtual path the key is locked to; null = everything the owner can reach
  maxUploadBytes BigInt?   @map("max_upload_bytes")       // per-key upload size cap; null = server default

  lastUsedAt     DateTime? @map("last_used_at")
  lastUsedIp     String?   @map("last_used_ip")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String    @map("user_id")

  @@index([userId], name: "idx_api_key_user_id")
  @@map("api_keys")
}

// Temporary file handed out by link; deleted when it expires or runs out of downloads.
// The file lives at <baseDir>/<id>/file; the original name is only kept here.
model Drop {
  id           String    @id                                // random, also the public link id
  fileName     String    @map("file_name")
  size         BigInt    @default(0)
  mimeType     String?   @map("mime_type")
  baseDir      String    @map("base_dir")                   // drop folder on disk that holds this drop right now
  expiresAt    DateTime  @map("expires_at")
  maxDownloads Int?      @map("max_downloads")              // null = unlimited
  downloads    Int       @default(0)
  completedAt  DateTime? @map("completed_at")               // null while the upload is still running
  deletedAt    DateTime? @map("deleted_at")                 // file removed; row kept a while for the owner's list
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String    @map("user_id")
  keyId        String?   @map("key_id")                     // API key that uploaded it, if any

  @@index([userId], name: "idx_drop_user_id")
  @@index([expiresAt], name: "idx_drop_expires_at")
  @@map("drops")
}


// Link that lets people without an account send files into a folder of the owner's.
// Files are saved as the owner, so the owner's folder access is checked on every upload.
model Inbox {
  id            String    @id                                // random, used in the link when slug is null
  slug          String?   @unique                            // optional custom link name
  title         String
  description   String?
  targetPath    String    @map("target_path")                // virtual folder in the owner's space
  splitBySender Boolean   @default(false) @map("split_by_sender")
  requireName   Boolean   @default(false) @map("require_name")
  showReceived  Boolean   @default(false) @map("show_received")
  allowedExt    String?   @map("allowed_ext")                // comma-separated, lower case, no dot; null = any
  maxFileBytes  BigInt?   @map("max_file_bytes")             // null = server upload cap
  maxTotalBytes BigInt?   @map("max_total_bytes")            // null = only the owner's quota
  maxFiles      Int?      @map("max_files")                  // null = unlimited
  passwordHash  String?   @map("password_hash")
  usedBytes     BigInt    @default(0) @map("used_bytes")     // received plus uploads in progress
  fileCount     Int       @default(0) @map("file_count")     // same, counted in files
  expiresAt     DateTime? @map("expires_at")                 // null = never
  closedAt      DateTime? @map("closed_at")                  // paused by the owner or an admin
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String    @map("user_id")
  uploads       InboxUpload[]

  @@index([userId], name: "idx_inbox_user_id")
  @@map("inboxes")
}

// Receipt for one file sent through an inbox; the file itself lives in the owner's space
model InboxUpload {
  id         String   @id @default(cuid())
  fileName   String   @map("file_name")                     // name it was saved under
  path       String                                          // virtual path it was saved to
  size       BigInt
  senderName String?  @map("sender_name")
  senderIp   String?  @map("sender_ip")                      // for abuse checks; cleared after 30 days
  createdAt  DateTime @default(now()) @map("created_at")

  inbox      Inbox    @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  inboxId    String   @map("inbox_id")

  @@index([inboxId], name: "idx_inbox_upload_inbox_id")
  @@map("inbox_uploads")
}
