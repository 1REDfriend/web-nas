# Copy to .env and fill in. Docker (docker-compose.yaml) overrides DATABASE_URL,
# STORAGE_ROOT, STORAGE_INTERNAL, STORAGE_WRITABLE_PATHS and DROPS_DEFAULT_DIR,
# so for Docker only the secrets and the optional values matter.

# --- Required ---

# SQLite file, relative to prisma/
DATABASE_URL="file:./main.sqlite"

# Name of the login cookie
TOKEN_COOKIE="webnas_session"

# Long random string that signs logins, e.g. `openssl rand -hex 32`.
# The app refuses to log anyone in while it is empty.
JWT_SECRET=""

# Folder the file manager is rooted at (absolute path)
STORAGE_ROOT=""

# Folder for the app's own files: trash, thumbnails, drops (default "storage")
STORAGE_INTERNAL="storage"

# --- Optional ---

# Host of the web terminal, e.g. nas-ssh.example.com; empty = "<this host>:7255"
# TERMINAL_HOST=""

# Parent domain for the login cookie when the terminal is on another subdomain
# COOKIE_DOMAIN="example.com"

# Comma-separated absolute paths that no role (not even ADMIN) can touch
# PROTECTED_PATHS=""

# Comma-separated absolute paths that are real disk; writes anywhere else are refused
# STORAGE_WRITABLE_PATHS=""

# Requests per minute each API key may make (default 120)
# API_KEY_RATE_LIMIT=120

# Address people use to reach the app, for links in API answers; empty = from the request
# PUBLIC_URL="https://nas.example.com"

# Folder for drops until an admin picks another one; empty = "<STORAGE_INTERNAL>/drops"
# DROPS_DEFAULT_DIR=""

# How often expired drops are deleted, in seconds (default 300)
# DROPS_SWEEP_SECONDS=300

# --- Docker only (read by docker-compose.yaml) ---

# The only host folder the app can see, mounted at /host_root<NAS_HOST_DIR>
# NAS_HOST_DIR="/mnt"

# Host user and group the app runs as
# PUID=1000
# PGID=1000

# Host ports published by Caddy
# WEBNAS_PORT=5491
# WEBSSH_PORT=7255

# Host folder for drops, inside NAS_HOST_DIR; default "<NAS_HOST_DIR>/drops"
# NAS_DROPS_DIR="/mnt/drops"
